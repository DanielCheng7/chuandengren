# AI 配置模板（本文件**不含任何密钥**，可以进仓库）
#
# 建议顺序：
#   1) 普通体验／队友测试 → 直接跑 `npm run dev`，在游戏里打开 **设置 → AI 模型**，
#      填自己的「模型名称 / API Base URL / API Key」并点「保存并启用」。
#      配置存在浏览器 localStorage，换人换 Key 随时切换，**不会进 git**。
#   2) 想给整台机器／答辩演示机一个默认值 → 复制本文件为 `.env.local`（已 gitignore）。
#
# 说明：前端只发到同源 `/api/ai`，Key 由服务端代理转发，不进前端代码、不进构建产物；
# 设置页填的 Key 随请求体发给同一个代理，代理不回显、不打日志。

# ① 密钥（留空则必须靠设置页填）
AI_API_KEY=

# ② 上游地址（OpenAI 兼容：`POST {base}/chat/completions`）
#    火山方舟   https://ark.cn-beijing.volces.com/api/v3
#    DeepSeek   https://api.deepseek.com/v1
#    阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#    智谱       https://open.bigmodel.cn/api/paas/v4
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ③ 模型：方舟填「推理接入点 ID」（ep- 开头）或模型 ID（doubao-…）
AI_MODEL=

# ④ 可选：上游超时（ms），默认 7000（比前端 8s 判定超时早一步，好回 504）
# AI_TIMEOUT_MS=7000

# ⑤ 可选：思考模式，默认 disabled。
#    思考模型（DeepSeek-V4.1、doubao-seed …）不关思考会先吐 reasoning_content，
#    token 用尽时 content 是空的，判定就废了。换到不认这个参数的网关时设 default（= 不传）。
# AI_THINKING=disabled

# ⑥ 可选：前端直连别的代理服务时用（一般不用动；留空 = 走本站 /api/ai）
# VITE_AI_ENDPOINT=http://127.0.0.1:8787/api/ai
